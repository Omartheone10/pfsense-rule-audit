<?xml version="1.0"?>
<pfsense>
  <aliases>
    <alias>
      <name>WebServers</name>
      <address>192.168.1.100 192.168.1.101</address>
    </alias>
  </aliases>

  <filter>
    <!-- Rule 1: pass, WAN, specific dest. No descr. -->
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination>
        <address>192.168.1.100</address>
        <port>443</port>
      </destination>
    </rule>

    <!-- Rule 2: block any-any. No descr. Should NOT be CRITICAL. -->
    <rule>
      <type>block</type>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination><any/></destination>
    </rule>

    <!-- Rule 3: block, specific source + dest. No descr. -->
    <rule>
      <type>block</type>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source>
        <address>10.0.0.5</address>
      </source>
      <destination>
        <address>192.168.1.100</address>
        <port>22</port>
      </destination>
    </rule>

    <!-- Rule 4: block, alias dest. HAS descr. No findings. -->
    <rule>
      <type>block</type>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source>
        <address>10.0.0.5</address>
      </source>
      <destination>
        <address>WebServers</address>
        <port>22</port>
      </destination>
      <descr>Block SSH from known bad host</descr>
    </rule>

    <!-- Rule 5: true any-any pass on WAN. No descr. Fires BOTH checks. -->
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination><any/></destination>
    </rule>

    <!-- Rule 6: pass on LAN. No descr. Tests that descr check isn't WAN-only. -->
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination>
        <address>192.168.1.100</address>
        <port>443</port>
      </destination>
    </rule>

    <!-- Rule 7: true any-any pass on WAN, WITH descr. Fires CRITICAL only. -->
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination><any/></destination>
      <descr>Temporary debugging rule - remove after incident</descr>
    </rule>

    <!-- Rule 8: disabled rule on LAN. HAS descr. Fires LOW only. -->
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination><any/></destination>
      <descr>Old testing rule</descr>
      <disabled/>
    </rule>

    <!-- Rule 9: pass, WAN, port 22. HAS descr. Fires HIGH (Admin Services) only. -->
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination>
        <address>192.168.1.100</address>
        <port>22</port>
      </destination>
      <descr>Remote SSH access for admin</descr>
    </rule>

        <!-- Rule 10: block, WAN, with log. HAS descr + log. Should fire ZERO findings. -->
    <rule>
      <type>block</type>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source>
        <address>10.0.0.99</address>
      </source>
      <destination>
        <address>192.168.1.100</address>
        <port>3389</port>
      </destination>
      <descr>Block RDP from suspicious host - logged for SIEM</descr>
      <log/>
    </rule>

  </filter>
</pfsense>